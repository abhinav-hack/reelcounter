# Copy this file to keystore.properties and replace every placeholder.
# Keep keystore.properties private; it is ignored by git.
# Use forward slashes in this properties file to avoid backslash escaping.
reelCounterReleaseStoreFile=C:/absolute/path/to/reelcounter-upload-key.jks
reelCounterReleaseStorePassword=replace-me
reelCounterReleaseKeyAlias=reelcounter-upload
reelCounterReleaseKeyPassword=replace-me
